{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "printWidth": 100,
  "arrowParens": "avoid",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "coverage",
    ".nyc_output",
    "docs/public",
    "docs/static/js/*.min.js",
    "docs/static/css/*.min.css",
    "docs/layouts/index.html",
    "docs/layouts/*.gitignore"
  ]
}
