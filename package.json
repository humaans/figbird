{
  "name": "figbird",
  "version": "0.24.0-pre.23",
  "description": "Effortless realtime data management for React + Feathers applications.",
  "type": "module",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./tsconfig.json": "./tsconfig.json",
    ".": {
      "types": "./dist/esm/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    },
    "./testing": {
      "types": "./dist/esm/testing.d.ts",
      "require": "./dist/cjs/testing.js",
      "import": "./dist/esm/testing.js"
    }
  },
  "files": [
    "dist",
    "lib",
    "!dist/*/devtools",
    "!lib/devtools",
    "CHANGELOG.md",
    "README.md",
    "LICENSE.md",
    "tsconfig.json"
  ],
  "scripts": {
    "test": "npm run tsc && npm run lint && oxfmt --check '**/*.{ts,tsx,js,jsx,css,yml}' && c8 ava",
    "lint": "oxlint -c oxlintrc.json --deny-warnings",
    "tsc": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/figbird/tsconfig.tsbuildinfo",
    "ava": "ava",
    "format": "oxfmt --write '**/*.{ts,tsx,js,jsx,css,yml}'",
    "coverage": "c8 -r html -r text ava",
    "build": "node ./tasks/build.js",
    "devtools:build": "node ./tasks/build-devtools.js",
    "devtools:check": "npm run tsc && npm run lint && oxfmt --check '**/*.{ts,tsx,js,jsx,css,yml}' && npm run devtools:test && npm run devtools:package",
    "devtools:package": "npm run devtools:build && node ./tasks/package-devtools.js",
    "devtools:sign:firefox:local": "node ./tasks/sign-firefox-devtools-local.js",
    "devtools:test": "ava test/devtools.test.tsx",
    "prepack": "npm run build",
    "watch": "node ./tasks/build.js -w",
    "demo": "npm --prefix demo install && npm --prefix demo run dev",
    "demo:server": "npm --prefix demo run dev:server",
    "demo:client": "npm --prefix demo run dev:client",
    "docs": "hugo server -s docs",
    "docs:build": "hugo -s docs",
    "docs:release": "hugo -s docs && gh-pages -d docs/public",
    "package:check": "npm run build && node tasks/check-package.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Humaans",
  "repository": {
    "type": "git",
    "url": "https://github.com/humaans/figbird"
  },
  "license": "ISC",
  "dependencies": {
    "sift": "^17.1.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ava": "^8.4.0",
    "browserslist-config-baseline": "^0.5.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "execa": "^10.2.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "sideEffects": false,
  "overrides": {
    "minimatch": "^10.0.0",
    "multimatch": {
      "minimatch": "^3.1.2"
    }
  }
}
