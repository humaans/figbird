{
  "manifest_version": 2,
  "name": "Figbird Devtools",
  "description": "Inspect Figbird queries, realtime events, fetches, and writes.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "devtools_page": "devtools.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "devtools@figbird.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
