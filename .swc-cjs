{
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "tsx": true
    },
    "transform": {
      "react": {
        "runtime": "automatic"
      }
    }
  },
  "module": {
    "type": "commonjs"
  },
  "env": {
    "targets": {
      "browsers": ["extends browserslist-config-baseline"]
    }
  },
  "sourceMaps": true,
}
